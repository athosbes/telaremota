// Recursos do telaremota.exe: compilados por scripts/icone.sh em
// rsrc_windows_amd64.syso, que o "go build" embute no executável.
// A versão do programa vem da tag do git (telaremota versão); aqui ficam só
// os textos que o Windows mostra em Propriedades → Detalhes e no Gerenciador
// de Tarefas.
#pragma code_page(65001)
LANGUAGE 0x16, 0x1 // português (Brasil)

1 ICON "telaremota.ico"

1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "athosbes"
      VALUE "FileDescription", "TelaRemota"
      VALUE "InternalName", "telaremota"
      VALUE "LegalCopyright", "Copyright (C) 2026 athosbes. Licença GNU AGPL-3.0."
      VALUE "OriginalFilename", "telaremota.exe"
      VALUE "ProductName", "TelaRemota"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
